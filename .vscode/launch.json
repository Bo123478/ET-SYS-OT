    "version": "0.2.0",
    "configurations": [
        
        {
"name": "ET: Start Workbench",
"type": "PowerShell",
"request": "launch",
"script": "${workspaceFolder}/ETWorkbench/Start-ETWorkbench.ps1",
"cwd": "${workspaceFolder}"
},
{
"name": "ET: SelfTest",
"type": "PowerShell",
"request": "launch",
"script": "${workspaceFolder}/ETWorkbench/Start-ETWorkbench.ps1",
"args": ["-SelfTest"],
"cwd": "${workspaceFolder}"
},
{
"name": "ET: Integration Test",
"type": "PowerShell",
"request": "launch",
"script": "${workspaceFolder}/tools/Test-ETIntegration.ps1",
"cwd": "${workspaceFolder}"
}
]
        {
            "name": "PowerShell: Launch Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "args": []
        }
    ]
}