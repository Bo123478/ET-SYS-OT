<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Workbench.Desktop</RootNamespace>
    <AssemblyName>Workbench.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Workbench.Domain\Workbench.Domain.csproj" />
    <ProjectReference Include="..\Workbench.Application\Workbench.Application.csproj" />
    <ProjectReference Include="..\Workbench.Contracts\Workbench.Contracts.csproj" />
    <ProjectReference Include="..\Workbench.Infrastructure\Workbench.Infrastructure.csproj" />
  </ItemGroup>

</Project>
