<Window x:Class="Workbench.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ET 工作台" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
  <!-- 骨架布局：左上软件区 / 右上信息区 / 右下报警区
       TODO: 接入 MVVM 视图模型与状态绑定。 -->
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="240" />
      <RowDefinition Height="*" MinHeight="240" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="320" />
      <ColumnDefinition Width="*" MinWidth="320" />
    </Grid.ColumnDefinitions>

    <!-- 左上：软件区 -->
    <GroupBox Grid.Row="0" Grid.Column="0" Header="软件" Margin="0,0,6,6">
      <TextBlock Text="待接入：工程必需软件清单与状态"
                 Foreground="Gray" TextWrapping="Wrap" Margin="8" />
    </GroupBox>

    <!-- 右上：信息区 -->
    <GroupBox Grid.Row="0" Grid.Column="1" Header="设备信息" Margin="6,0,0,6">
      <TextBlock Text="待接入：SN、IP、设备 ID、业务工程、登录校验结果"
                 Foreground="Gray" TextWrapping="Wrap" Margin="8" />
    </GroupBox>

    <!-- 右下：报警区 -->
    <GroupBox Grid.Row="1" Grid.Column="1" Header="报警" Margin="6,6,0,0">
      <TextBlock Text="待接入：Windows 健康检测与报警历史"
                 Foreground="Gray" TextWrapping="Wrap" Margin="8" />
    </GroupBox>
  </Grid>
</Window>
