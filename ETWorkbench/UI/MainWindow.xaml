<?xml version="1.0" encoding="utf-8"?>
<!--
  ET 工作台主窗口

  设计原则（方案 §8.5 / 约束 C-3）：
    · 只传标识符（SoftwareId / RuleId / RequestId），界面上没有任何「自由路径 → 执行」的入口
    · 不做自动修复类按钮（红线 F-7 / F-8）
    · 状态展示诚实：Downloaded 绝不显示为已安装/已生效（约束 C-6）

  本文件含中文，保存为 UTF-8 with BOM（约束 C-1）。
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ET 工作台 —— 现场终端数字化运维"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="#FFE8EDF3">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Background" Value="#FF2F6FB5"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF3D7FC4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF25598F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock" x:Key="Label">
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Foreground" Value="#FF44505F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox" x:Key="Output">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
      <Setter Property="Background" Value="#FF1E2430"/>
      <Setter Property="Foreground" Value="#FFD7DEE8"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ============ 卡片样式（内容卡片化） ============ -->
    <Style TargetType="Border" x:Key="Card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="#FFD9E1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="14"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#FF000000"/>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 导航标签卡片化（胶囊式 Tab） ============ -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#FF44505F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd"
                    Background="#FFE9EEF5"
                    BorderBrush="#FFD9E1EA"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Cursor="Hand">
              <ContentPresenter x:Name="ContentSite"
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFDFE7F1"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF2F6FB5"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2F6FB5"/>
                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============================ 标题栏 ============================ -->
    <Border Grid.Row="0" Padding="18,14">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#FF1B3A5C" Offset="0"/>
          <GradientStop Color="#FF2F6FB5" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- logo 方块 -->
        <Border Grid.Column="0"
                Width="44" Height="44"
                CornerRadius="10"
                Background="#33FFFFFF"
                Margin="0,0,14,0">
          <TextBlock Text="ET"
                     Foreground="White"
                     FontSize="18" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="TxtTitle"
                     Text="ET 工作台"
                     Foreground="White" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="现场终端数字化运维 · ET 端（离线可用，不开放端口）"
                     Foreground="#FFB9CBE0" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ 主体 ============================ -->
    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12" Background="Transparent" BorderThickness="0">

      <!-- ============ 页签 1：我是谁 / 该装什么（E-02） ============ -->
      <TabItem Header="我是谁">
        <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Label}"
                     Text="识别链：物理机序列号 → 业务 IP → 设备编号 → 工程编号 → 应用 → 批准版本"/>
          <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#FF6B7787" Margin="0,0,0,10"
                     Text="说明：识别失败时不会猜测，只报告卡在哪一步。请确认主数据已发布，且本机业务网卡未被网络策略过滤。"/>

          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
              <Button x:Name="BtnIdentify" Content="开始识别"/>
            </StackPanel>
            <TextBox Grid.Row="1" x:Name="TxtIdentityOut" Style="{StaticResource Output}"/>
          </Grid>
        </Grid>
        </Border>
      </TabItem>

      <!-- ============ 页签 2：软件入口与状态（E-03） ============ -->
      <TabItem Header="软件状态">
        <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="七态模型（约束 C-6：已下载 ≠ 已安装 ≠ 已生效）"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnRefreshSoft" Content="刷新状态"/>
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="SoftCardPanel"/>
          </ScrollViewer>
          <TextBlock Grid.Row="3" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7787"
                     Text="「已下载」表示文件已就位但尚未安装/未确认生效。本工具不会自动安装、不会结束或重启业务软件。"/>
        </Grid>
        </Border>
      </TabItem>

      <!-- ============ 页签 3：一键下载（E-04） ============ -->
      <TabItem Header="一键下载">
        <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="发布包整文件夹递归复制 → 逐文件 SHA256 校验 → 原子发布（.tmp → .ready）"/>

          <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="应用：" VerticalAlignment="Center" Width="60"/>
              <ComboBox x:Name="CmbApplication" Width="260" Height="26"/>
              <TextBlock Text="版本：" VerticalAlignment="Center" Width="60" Margin="16,0,0,0"/>
              <ComboBox x:Name="CmbVersion" Width="160" Height="26"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnPlan" Content="生成计划"/>
              <Button x:Name="BtnDownload" Content="开始下载"/>
            </StackPanel>
          </StackPanel>

          <TextBox Grid.Row="2" x:Name="TxtDownloadOut" Style="{StaticResource Output}"/>
        </Grid>
        </Border>
      </TabItem>

      <!-- ============ 页签 4：健康检测（E-05） ============ -->
      <TabItem Header="健康检测">
        <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Label}"
                     Text="采集 → 评估 → 持续时长 → 防抖 → 去重 → 告警 → 恢复（方案 §6.8）"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnHealthCheck" Content="立即检测"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FF6B7787"
                       Text="（周期采集由计划任务 ET-HealthMonitor 负责）"/>
          </StackPanel>
          <DataGrid Grid.Row="2" x:Name="GridHealth"
                    AutoGenerateColumns="True"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    RowHeaderWidth="0"
                    MaxHeight="320"
                    Background="White"
                    BorderBrush="#FFD5DCE5"/>
          <TextBox Grid.Row="3" x:Name="TxtHealthOut" Style="{StaticResource Output}"
                   Height="140" Margin="0,10,0,0"/>
        </Grid>
        </Border>
      </TabItem>

      <!-- ============ 页签 5：主数据（E-01） ============ -->
      <TabItem Header="主数据">
        <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="主数据由运维维护并发布到共享；本机只做「拉取快照」与「草稿校验」"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnMdLoad" Content="拉取最新快照"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FF6B7787"
                       Text="快照会缓存在本机，断网时继续可用"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="类型：" VerticalAlignment="Center" Width="60"/>
            <ComboBox x:Name="CmbMdKind" Width="180" Height="26"/>
            <TextBlock Text="文件：" VerticalAlignment="Center" Width="60" Margin="16,0,0,0"/>
            <TextBox x:Name="TxtMdPath" Width="420" Height="26" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnMdValidate" Content="校验草稿" Margin="12,0,0,0"/>
          </StackPanel>

          <TextBox Grid.Row="3" x:Name="TxtMdOut" Style="{StaticResource Output}"/>

          <TextBlock Grid.Row="4" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF6B7787"
                     Text="校验项：JSON 合法性、主键唯一、外键引用（设备→设备编号）、版本号格式，并检测全角逗号/全角引号等常见录入错误。"/>
        </Grid>
        </Border>
      </TabItem>

      <!-- ============ 页签 6：关于与自更新（E-06） ============ -->
      <TabItem Header="关于">
        <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Label}"
                     Text="自更新：下载 → 校验 → 备份 → 原子切换 Current.json 指针 → 冒烟测试 → 失败回滚"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnCheckUpdate" Content="检查更新"/>
            <Button x:Name="BtnSelfUpdate" Content="立即更新"/>
          </StackPanel>
          <TextBox Grid.Row="2" x:Name="TxtUpdateOut" Style="{StaticResource Output}" Height="200"/>

          <TextBox Grid.Row="3" x:Name="TxtAbout" Style="{StaticResource Output}"
                   Height="200" Margin="0,10,0,0"/>
        </Grid>
        </Border>
      </TabItem>

    </TabControl>

    <!-- ============================ 状态条 ============================ -->
    <Border Grid.Row="2" Background="#FFE7ECF2" BorderBrush="#FFD5DCE5" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse Grid.Column="0" x:Name="StatusBarDot" Width="10" Height="10" Fill="#FF2FBF71" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="1" x:Name="TxtStatus"
                   Text="就绪"
                   Foreground="#FF44505F"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" x:Name="TxtIdentity" Text="设备：未识别" Margin="16,0,16,0" Foreground="#FF44505F" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" x:Name="TxtShare" Text="共享：未检查" Margin="0,0,16,0" Foreground="#FF44505F" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" x:Name="TxtVersion" Text="版本：未知" Foreground="#FF44505F" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
