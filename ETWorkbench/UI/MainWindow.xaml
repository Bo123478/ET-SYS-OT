<?xml version="1.0" encoding="utf-8"?>
<!--
  ET 工作台主窗口 —— 页签式功能区
  ==============================================================================
  对齐《ET工作台方案_Version2.md》「现场条件」（左上软件区 / 右上信息区 / 右下报警区）：
      三区的**业务内容与判定口径完整保留**，改的只是呈现方式 ——
      旧版把三区做成常驻面板，矮屏上每区都只剩几十像素高；
      新版改成页签，同一时刻只有一区在前台，每区都能拿到整块高度。

  页签（数量与顺序是 Start-ETWorkbench.ps1 的导航契约；顺序于 2026-09-30 调整，
        信息区前移为 0 号并成为【默认打开页】，改动必须同批改脚本 §7.1 的页签名常量）：
      0 信息区     内嵌铭牌卡（与左侧铭牌同款同源）+ 状态摘要 + 本机与边界 / 识别链
      1 生产软件   软件卡片按功能分组（生产软件 / 系统工具 / 周边）+ 一键下载
      2 警告提示   分类卡片汇总 + 三态图例 + 详细列表
      3 功能设置   允许上报开关 / 自动检查更新开关 / 生产软件一键更新 / 维护动作
      4 主数据     快照拉取 + 草稿校验（方案 §13.1 锁定决策 21：主数据必须是页签）

  Grid
  ├ Row0  顶栏       主标题 · 时钟 · 全屏 · 关闭工作台
  ├ Row1  页签区     MainTabs（可见）
  └ Row2  状态条     摘要 / 设备 / 共享 / 版本 / 三态状态灯

  为什么不做真正的「替换桌面」：
    · 方案 §3.1 明文：不替换 Explorer、不移除任务栏与开始菜单、不改登录方式
    · Shell Launcher 仅支持 Enterprise / Education / IoT，现场是**专业版**
    · 现场业务软件需 24 小时常驻，接管 Shell 会连坐其生命周期（撞红线 F-1 / F-2）

  本窗口的「桌面」语义（全部由 Start-ETWorkbench.ps1 在运行时设置）：
    · 无边框、不占任务栏（ShowInTaskbar=False）、不参与 Alt+Tab（WS_EX_TOOLWINDOW）
    · 启动即铺满【工作区】（不是整个屏幕）—— 工作区已排除任务栏，故不会盖住任务栏
    · 永远沉在所有窗口的最底层：不用 Topmost（红线 F-4 禁置顶），
      而是用 SetWindowPos(HWND_BOTTOM) 沉底，并在前台窗口切换时重新沉底。
      ⇒ 业务软件永远盖在工作台之上；要点工作台，先把业务软件最小化。

  铭牌（UI\PlateBar.xaml）：
    「铭牌」是【另一个进程的无边框窗口】（Start-ETPlate.ps1），
    位置 = 工作区【左边缘、垂直居中】，尺寸 316 x 248（竖版工业铭牌卡）。
    ⇒ 它是独立窗口，与本窗口【不做像素对齐】。
    ⇒ 铭牌与主窗口都会沉底，Z 序谁上谁下都不影响观感，不必额外协调。
    ⇒ 本窗口内的状态色指示只有底部状态条的 StatusBarDot（三态灯）。

  三态口径（重要）：
    底部 StatusBarDot 与铭牌的判定【必须同源】，否则会出现「铭牌红、窗口绿」。
    规则表在 Start-ETWorkbench.ps1 §8.2，与 Start-ETPlate.ps1 的 $Script:PlateRules
    逐条一致；任一处改动都要同步改另一处（缺陷 D-10）。

  重要（改前必读）：
    · 所有 x:Name 全局唯一 —— 同一个名字出现两次会导致 XamlReader 直接抛异常。
    · 名字同时被 Start-ETWorkbench.ps1 按名取用；改名只会打印一条 Warn 后静默
      不注册事件，不报错，极难排查。
    · 删掉某个 x:Name 时，必须**同一批**删掉脚本里的 $ui.<同名>，否则
      tools/Test-ETIntegration.ps1 的「每个 $ui.<Name> 都存在」硬门禁直接报红。
    · 视觉常量集中在 Window.Resources 顶部，色板与铭牌 PlateBar.xaml 一致。

  本文件含中文，保存为 UTF-8 with BOM（约束 C-1）。
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ET 工作台 —— 现场终端数字化运维"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="#FFE8EDF3">

  <Window.Resources>

    <!-- ================= 视觉常量（改主题只动这里） ================= -->
    <!-- 色板与铭牌 PlateBar.xaml 一致（BrOk / BrWarn / BrAlarm 与 PlateState 三色同值） -->
    <SolidColorBrush x:Key="BrOk"    Color="#FF2FBF71"/>
    <SolidColorBrush x:Key="BrWarn"  Color="#FFF2C94C"/>
    <SolidColorBrush x:Key="BrAlarm" Color="#FFE5533D"/>

    <!-- ================= 通用按钮（主按钮：蓝底白字） ================= -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Background" Value="#FF2F6FB5"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF3D7FC4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF25598F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次要按钮：白底描边（用于区标题右侧的动作） -->
    <Style TargetType="Button" x:Key="Ghost">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinWidth" Value="76"/>
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="Foreground" Value="#FF2F6FB5"/>
      <Setter Property="BorderBrush" Value="#FF2F6FB5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEAF2FB"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFD8E7F8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 顶栏小按钮：半透明白（深色底上） -->
    <Style TargetType="Button" x:Key="TopBtn">
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Background" Value="#26FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#59FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 顶栏危险按钮：关闭工作台（无边框窗口唯一的可见出口，所以给高对比红） -->
    <Style TargetType="Button" x:Key="DangerBtn">
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="Background" Value="#FFC0392B"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFD0483A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF9E2E22"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBlock" x:Key="Label">
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Foreground" Value="#FF44505F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionTitle">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FF1B2B3A"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionNote">
      <Setter Property="Foreground" Value="#FF8A97A6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style TargetType="TextBox" x:Key="Output">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
      <Setter Property="Background" Value="#FF1E2430"/>
      <Setter Property="Foreground" Value="#FFD7DEE8"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TextBox" x:Key="Input">
      <Setter Property="Height" Value="26"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="BorderBrush" Value="#FFC9D4E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#FFFFFFFF"/>
    </Style>

    <!-- ============ 内嵌铭牌卡（「信息区」左列，版式与 PlateBar.xaml 一致） ============
         316 x 248、左侧 6px 整高状态灯条、四角 16 圆角、深色工业渐变底。
         与 PlateBar.xaml 的差异仅两处，均为「内嵌控件 vs 独立窗口」的必然差异：
           · 不画窗口阴影（内嵌卡片再叠阴影显脏）
           · 四角都圆（铭牌窗口只圆右侧，因为它紧贴屏幕左边缘）
         三态颜色不是写死的：由 Start-ETWorkbench.ps1 §12.7 Update-PlateCard 赋值，
         初始值 #FF2FBF71 只代表「加载瞬间 = 正常」。 -->
    <Style TargetType="Border" x:Key="PlateCard">
      <Setter Property="Width" Value="316"/>
      <Setter Property="Height" Value="248"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="#553FA9E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF17395F" Offset="0"/>
            <GradientStop Color="#FF0D2338" Offset="0.55"/>
            <GradientStop Color="#FF08182A" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 区域卡片 -->
    <Style TargetType="Border" x:Key="Region">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="#FFD9E1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.14" Color="#FF000000"/>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 浅底胶囊：用于「警告提示」的分类计数徽章 / 信息区的键值对 -->
    <Style TargetType="Border" x:Key="Pill">
      <Setter Property="Background" Value="#FFF4F7FB"/>
      <Setter Property="BorderBrush" Value="#FFD9E1EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <!-- 健康表格 -->
    <Style TargetType="DataGrid" x:Key="HealthGrid">
      <Setter Property="AutoGenerateColumns" Value="True"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#FFE6ECF3"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#FFD5DCE5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowHeight" Value="26"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ============ 页签容器：只提供「标签条 + 内容」两段，不带任何边框 ============ -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel Background="Transparent">
              <TabPanel DockPanel.Dock="Top" IsItemsHost="True"
                        Background="Transparent" Margin="0,0,0,12"/>
              <ContentPresenter ContentSource="SelectedContent"/>
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 导航标签卡片化（胶囊式 Tab） ============ -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#FF44505F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFD9E1EA"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="20,9"
                    Margin="0,0,10,0"
                    Cursor="Hand">
              <ContentPresenter x:Name="ContentSite"
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFEAF2FB"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF2F6FB5"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2F6FB5"/>
                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ==================================================================
         Row 0 · 顶栏（只留 标题 / 时钟 / 全屏 / 关闭工作台）
         铭牌（PlateBar.xaml）是【左侧垂直居中的 316x248 竖版卡】，独立进程，
         与本顶栏不做像素对齐。
         · 通则说明与摘要文字已移除：同一句话在顶栏和底栏各写一遍，措辞又各说
           各话，现场读起来像两个结论（缺陷 D-8）。摘要只保留底栏一处。
         · 「主数据」「关于」不再做抽屉入口 —— 它们是页签 4 / 页签 3。
         ================================================================== -->
    <Border Grid.Row="0" MinHeight="64" Padding="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#FF17395F" Offset="0"/>
          <GradientStop Color="#FF0D2338" Offset="0.55"/>
          <GradientStop Color="#FF08182A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>

      <!-- 内层 Grid 用负外边距向右上拉伸，填满 Padding=0 之外的整条顶栏
           （例如高 DPI 下顶栏实际高于 64 时，渐变与按钮都跟着拉伸，不留空隙） -->
      <Grid Margin="-24,-24,-24,-24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 主标题（水平+垂直居中，字号加大） ========== -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="系统运维 · ET端"
                     Foreground="White" FontSize="26" FontWeight="Bold"
                     HorizontalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- ========== 列 1 · 时钟 + 逃生通道 ========== -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TxtClock" Text="--:--" Foreground="White" FontSize="18"
                     FontWeight="SemiBold" FontFamily="Consolas, Microsoft YaHei UI"
                     VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="BtnFullScreen" Style="{StaticResource TopBtn}" Content="全屏"
                  ToolTip="铺满工作区 / 还原（F11）"/>
          <Button x:Name="BtnCloseWindow" Style="{StaticResource DangerBtn}" Content="关闭工作台"
                  ToolTip="关闭工作台窗口（不影响后台定时任务；Alt+F4 同效）"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================================================================
         Row 1 · 页签区（MainTabs）
         「左上软件区 / 右上信息区 / 右下报警区」的**业务内容与判定口径原样保留**，
         改的只是呈现方式：三区并排时常驻面板在矮屏上每区只剩几十像素高，
         改成页签后同一时刻只有一区在前台，每区都能拿到整块高度。

         索引顺序（2026-09-30 起）：0 信息区 / 1 生产软件 / 2 警告提示 / 3 功能设置 / 4 主数据。
         首个 TabItem 即启动默认页 ⇒ 主窗口打开时停在「信息区」。
         脚本侧一律按【页签标题】寻址（Start-ETWorkbench.ps1 §7.1 Select-ETTab），
         不再内联裸数字；如需再次调序，改本文件的 TabItem 次序即可，调用点不必动
         （页签序号本身仍是契约，见 ET-项目待办事项.md §3.7 G-07）。
         ================================================================== -->
    <TabControl Grid.Row="1" x:Name="MainTabs" Margin="14,14,14,0">

      <!-- ================================================================
           页签 0 · 信息区（默认打开页）
           左列＝与左侧【设备铭牌】一模一样的卡片（同 316x248 版式、同一套三态色、
                 同一条规则表），按用户要求放在信息区左上角；
                 它与 PlateBar.xaml 的唯一区别见 Window.Resources 的 PlateCard 样式。
                 三态同源：颜色由 Start-ETWorkbench.ps1 §12.7 按 §8.2 的规则表结论上色，
                 绝不在本页签内另写一套判定（否则「铭牌红、窗口绿」的 D-10 会复发）。
           右列＝铭牌同源摘要 / 本机与边界 / 识别链
           识别链：物理机序列号 → 业务 IP → 设备编号 → 工程编号 → 应用 → 批准版本。
           失败时不猜测，只报告卡在哪一步。
           ================================================================ -->
      <TabItem Header="信息区">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- ========== 左列：内嵌铭牌卡（与 PlateBar.xaml 同版式） ========== -->
          <Border Grid.Column="0" Style="{StaticResource PlateCard}" VerticalAlignment="Top">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 整高状态灯条：绿=正常 / 黄=警告 / 红=报警 -->
              <Border x:Name="PlateStrip" Grid.Column="0" Background="#FF2FBF71"/>

              <Grid Grid.Column="1" Margin="14,12,14,12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <!-- 编号行：必须 Auto，用 * 会让内容溢出、被页脚盖住 MPC -->
                  <RowDefinition Height="Auto"/>
                  <!-- 页脚：吃掉剩余空间并底部对齐 -->
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 抬头：铭牌名 + 报警状态胶囊 -->
                <Grid Grid.Row="0">
                  <TextBlock x:Name="PlateTitle"
                             Text="ET 工作台"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="#FF6FA8D8"
                             VerticalAlignment="Center"/>
                  <Border x:Name="PlateStatusPill"
                          HorizontalAlignment="Right"
                          CornerRadius="9"
                          Padding="8,3"
                          Background="#1AFFFFFF"
                          BorderBrush="#33FFFFFF"
                          BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="PlateStatusDot"
                               Width="9" Height="9"
                               Fill="#FF2FBF71"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                      <TextBlock x:Name="PlateStatusText"
                                 Text="正常"
                                 FontSize="11"
                                 Foreground="#FFE7F3FF"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- 标题：设备编号（大字，仿铭牌刻字） -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                  <TextBlock x:Name="PlateEquip"
                             Text="—"
                             FontFamily="Consolas"
                             FontSize="34" FontWeight="Bold"
                             Foreground="White"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="设 备 编 号"
                             FontSize="10"
                             Foreground="#FF5E86AE"
                             Margin="2,2,0,0"/>
                </StackPanel>

                <!-- 分隔线 -->
                <Border Grid.Row="2" Height="1" Background="#2E4C74" Margin="0,9,0,0"/>

                <!-- 编号行：ET / IP / MPC -->
                <Grid Grid.Row="3" Margin="0,9,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="ET"
                             FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF6FA8D8"/>
                  <TextBlock x:Name="PlateEt" Grid.Row="0" Grid.Column="1" Text="—"
                             FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="White"
                             TextTrimming="CharacterEllipsis"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="IP"
                             FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF6FA8D8" Margin="0,6,0,0"/>
                  <TextBlock x:Name="PlateIp" Grid.Row="1" Grid.Column="1" Text="—"
                             FontFamily="Consolas" FontSize="14" Foreground="#FFDCEBFA" Margin="0,6,0,0"
                             TextTrimming="CharacterEllipsis"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="MPC"
                             FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF6FA8D8" Margin="0,6,0,0"/>
                  <TextBlock x:Name="PlateMpc" Grid.Row="2" Grid.Column="1" Text="—"
                             FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"
                             TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 页脚：与铭牌同款（版本 + 刷新时间） -->
                <Grid Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Bottom">
                  <TextBlock x:Name="PlateVer" Text="铭牌 v1.1.0" FontSize="10.5" Foreground="#FF5E86AE"/>
                  <TextBlock x:Name="PlateUpdated" Text="—" FontSize="10.5" Foreground="#FF5E86AE"
                             HorizontalAlignment="Right"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>

          <!-- ========== 右列：状态摘要 / 本机与边界 / 识别链 ========== -->
          <Grid Grid.Column="1" Margin="14,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*" MinHeight="140"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 铭牌同源摘要（状态灯取的同一份判定结果 + 同一张规则表） -->
            <Border Grid.Row="0" Style="{StaticResource Region}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12,14,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="状态摘要"/>
                  <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                             Text="与左侧铭牌同源：判定规则表逐条一致，命中哪条就写哪条"/>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="14,0,14,14">
                  <Border Style="{StaticResource Pill}">
                    <TextBlock x:Name="TxtInfoState" Text="状态：—"
                               Foreground="#FF44505F" FontSize="12" FontWeight="SemiBold"/>
                  </Border>
                  <Border Style="{StaticResource Pill}">
                    <TextBlock x:Name="TxtInfoRule" Text="命中：—"
                               Foreground="#FF44505F" FontSize="12"/>
                  </Border>
                  <Border Style="{StaticResource Pill}">
                    <TextBlock x:Name="TxtInfoEquip" Text="设备：—"
                               Foreground="#FF44505F" FontSize="12"/>
                  </Border>
                  <Border Style="{StaticResource Pill}">
                    <TextBlock x:Name="TxtInfoApp" Text="应用：—"
                               Foreground="#FF44505F" FontSize="12"/>
                  </Border>
                  <Border Style="{StaticResource Pill}">
                    <TextBlock x:Name="TxtInfoPending" Text="待上报：—"
                               Foreground="#FF44505F" FontSize="12"/>
                  </Border>
                </WrapPanel>
              </Grid>
            </Border>

            <!-- 本机与边界信息（含原「关于」静态内容） + 识别链 -->
            <Border Grid.Row="1" Style="{StaticResource Region}" Margin="0,14,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12,14,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="本机与边界"/>
                  <Button x:Name="BtnIdentify" Grid.Column="1" Style="{StaticResource Ghost}"
                          Content="开始识别"/>
                </Grid>

                <TextBlock Grid.Row="1" Margin="14,0,14,10" TextWrapping="Wrap"
                           Foreground="#FF8A97A6" FontSize="11"
                           Text="识别链：物理机序列号 → 业务 IP → 设备编号 → 工程编号 → 应用 → 批准版本。失败时不猜测，只报告卡在哪一步。"/>
              </Grid>
            </Border>

            <TextBox Grid.Row="2" x:Name="TxtAbout" Style="{StaticResource Output}"
                     Margin="0,14,0,0"/>

            <TextBox Grid.Row="3" x:Name="TxtIdentityOut" Style="{StaticResource Output}"
                     Height="92" Margin="0,14,0,0"/>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ================================================================
           页签 1 · 应用区
           3 个区块：生产软件 / 系统工具 / 周边
           点击卡片直接打开，缺失应用时显示下载按钮
           ================================================================ -->
      <TabItem Header="应用区">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Region}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="应用区"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,8,0"
                           Text="固定应用清单：生产软件 / 系统工具 / 周边；卡片点击直接打开，缺失时给出下载入口。"/>
                <Button x:Name="BtnRefreshSoft" Grid.Column="2" Style="{StaticResource Ghost}"
                        Content="刷新状态"/>
              </Grid>

              <ScrollViewer Grid.Row="1" Margin="6,0,6,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="SoftCardPanel"/>
              </ScrollViewer>

              <TextBlock Grid.Row="2" Margin="14,8,14,12" TextWrapping="Wrap"
                         Foreground="#FF8A97A6" FontSize="11"
                         Text="应用卡片只显示名称、版本、编号与描述；点击打开对应软件；若目录中没有该应用则显示下载按钮。"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================================================================
           页签 2 · 警告提示
           分类卡片汇总 + 三态图例 + 详细列表
           三态图例与铭牌同一套色（避免两处颜色各说各话）
           ================================================================ -->
      <TabItem Header="警告提示">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
          </Grid.RowDefinitions>

          <!-- 分类卡片汇总（网络 / Windows 系统 / 共享 / 与系统清单对比） -->
          <Border Grid.Row="0" Style="{StaticResource Region}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="分类汇总"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                           Text="网络连通 / Windows 系统 / 共享与清单一致性 —— 逐类给出告警与警告条数"/>
              </Grid>

              <WrapPanel Grid.Row="1" x:Name="AlarmCardPanel" Margin="14,0,14,14"/>
            </Grid>
          </Border>

          <!-- 报警区（详细列表） -->
          <Border Grid.Row="1" Style="{StaticResource Region}" Margin="0,14,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,12,14,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="详细列表"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,8,0"
                           Text="采集 → 评估 → 持续时长 → 防抖 → 去重 → 告警 → 恢复"/>
                <Button x:Name="BtnHealthCheck" Grid.Column="2" Style="{StaticResource Ghost}"
                        Content="立即检测"/>
              </Grid>

              <!-- 三态图例（与铭牌同一套色，避免两处颜色各说各话） -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,8">
                <Ellipse Width="8" Height="8" Fill="{StaticResource BrAlarm}" VerticalAlignment="Center"/>
                <TextBlock Text="报警" FontSize="11" Foreground="#FF8A97A6" Margin="4,0,12,0"/>
                <Ellipse Width="8" Height="8" Fill="{StaticResource BrWarn}" VerticalAlignment="Center"/>
                <TextBlock Text="警告" FontSize="11" Foreground="#FF8A97A6" Margin="4,0,12,0"/>
                <Ellipse Width="8" Height="8" Fill="{StaticResource BrOk}" VerticalAlignment="Center"/>
                <TextBlock Text="正常" FontSize="11" Foreground="#FF8A97A6" Margin="4,0,0,0"/>
              </StackPanel>

              <DataGrid Grid.Row="2" x:Name="GridHealth" Style="{StaticResource HealthGrid}"
                        Margin="14,0,14,10"/>

              <TextBox Grid.Row="3" x:Name="TxtHealthOut" Style="{StaticResource Output}"
                       Height="72" Margin="14,0,14,14"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================================================================
           页签 3 · 功能设置
           两个开关 + 一键更新 + 维护动作
           开关语义（严格遵守红线）：
             「允许上报」      只控制 ET.Outbox 是否把事件发布到共享，不涉及下载/安装；
             「自动检查更新」  只针对【工作台自身】(E-06 / ET.Update)，不含业务软件；
             「生产软件一键更新」= 下载 + 校验，**止步于「已下载」**，
                                绝不等于已安装 / 已生效（红线 F-9 / 约束 C-6）。
           ================================================================ -->
      <TabItem Header="功能设置">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Region}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="开关"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                           Text="本机设置，写入 Config/settings.json（原子写，单写入者）"/>
              </Grid>

              <StackPanel Grid.Row="1" Margin="14,0,14,14">
                <CheckBox x:Name="ChkLogUpload" Content="允许上报（事件上报到共享 Upload）"
                          Foreground="#FF44505F" Margin="0,0,0,10"
                          ToolTip="只决定 ET.Outbox 是否把已生成的事件文件发布到共享。关闭后事件仍在本机排队，不丢失。"/>
                <CheckBox x:Name="ChkAutoUpdate" Content="自动检查工作台自身更新"
                          Foreground="#FF44505F" Margin="0,0,0,10"
                          ToolTip="只针对工作台自身（E-06 / ET.Update.psm1）。不会检查、更不会更新任何业务软件。"/>
                <Button x:Name="BtnOneKeyUpdate" Content="生产软件一键更新" Width="180"
                        HorizontalAlignment="Left"
                        ToolTip="对已选应用执行「下载 + 校验」。结果止步于「已下载」——不等于已安装、更不等于已生效。"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource Region}" Margin="0,14,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="应用下载"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                           Text="整文件夹递归复制 → 逐文件 SHA256 校验 → 原子发布（.tmp → .ready）"/>
              </Grid>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,10">
                <TextBlock Text="应用：" VerticalAlignment="Center" Width="52"/>
                <ComboBox x:Name="CmbApplication" Width="240" Height="26"/>
                <TextBlock Text="版本：" VerticalAlignment="Center" Width="52" Margin="16,0,0,0"/>
                <ComboBox x:Name="CmbVersion" Width="150" Height="26"/>
                <Button x:Name="BtnPlan" Content="生成计划" Margin="16,0,8,0"/>
                <Button x:Name="BtnDownload" Content="开始下载" Margin="0"/>
              </StackPanel>

              <TextBox Grid.Row="2" x:Name="TxtDownloadOut" Style="{StaticResource Output}"
                       Height="112" Margin="14,0,14,14"/>

              <Grid Grid.Row="3" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="工作台自身更新"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                           Text="下载 → 校验 → 备份 → 原子切换 Current.json 指针 → 冒烟测试 → 失败回滚"/>
              </Grid>

              <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="14,14,14,10">
                <Button x:Name="BtnCheckUpdate" Content="检查更新"/>
                <Button x:Name="BtnSelfUpdate" Content="立即更新"/>
              </StackPanel>

              <TextBox Grid.Row="5" x:Name="TxtUpdateOut" Style="{StaticResource Output}"
                       Height="120" Margin="14,0,14,14"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource Region}" Margin="0,14,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="维护动作"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                           Text="只做「打开目录」这类只读动作；不结束进程、不覆盖运行中文件、不重启电脑"/>
              </Grid>

              <StackPanel Grid.Row="1" Margin="14,0,14,10">
                <Button x:Name="BtnOpenDataRoot" Style="{StaticResource Ghost}"
                        Content="打开数据根目录" Width="150" HorizontalAlignment="Left"
                        ToolTip="用资源管理器打开本机数据根目录（只读动作）"/>
              </StackPanel>

              <!-- 计划任务节奏：只读展示。GUI 不假装能改任务计划 —— 实际节奏由
                   Tasks/Register-ETTasks.ps1 注册的计划任务决定，改这里不起作用（登记 T-38）。 -->
              <StackPanel Grid.Row="2" Margin="14,0,14,14">
                <TextBlock x:Name="TxtScheduleNote" TextWrapping="Wrap" Foreground="#FF8A97A6" FontSize="11"
                           ToolTip="采集/上报节奏由本机计划任务决定。此处只读展示，编辑无效。"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 本机偏好：默认值来自 Config/workstation.json 的 Ui 节，
               这里只是「本地覆盖」。写入 Config/settings.json，
               不触碰 workstation.json 的冻结键名（docs/interface-contract.md:52）。 -->
          <Border Grid.Row="3" Style="{StaticResource Region}" Margin="0,14,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="本机偏好"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                           Text="默认值取自 Config/workstation.json 的 Ui 节；这里只做本地覆盖，不修改冻结键名"/>
              </Grid>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,10">
                <TextBlock Text="日志级别" Width="90" VerticalAlignment="Center" Foreground="#FF44505F"/>
                <ComboBox x:Name="CmbLogLevel" Width="130" Margin="0,0,20,0"
                          ToolTip="控制写入本地日志的最低级别。等级越高，记录越少。"/>
                <TextBlock Text="日志保留（天）" Width="110" VerticalAlignment="Center" Foreground="#FF44505F"/>
                <TextBox x:Name="TxtLogRetentionDays" Width="80" VerticalAlignment="Center"
                         ToolTip="超过天数的历史日志会被清理。只清理工作台自己的日志，不动业务文件。"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,0,14,10">
                <TextBlock Text="界面字号" Width="90" VerticalAlignment="Center" Foreground="#FF44505F"/>
                <ComboBox x:Name="CmbUiScale" Width="130" Margin="0,0,20,0"
                          ToolTip="按现场最矮的分辨率选。只放大工作台自身的界面，不改系统的缩放与分辨率。"/>
                <TextBlock x:Name="TxtUiScaleNote" VerticalAlignment="Center"
                           Foreground="#FF8A97A6" FontSize="11"
                           Text="说明：只作用于未在样式里写死字号的文字；表格与顶栏保持固定字号。"/>
              </StackPanel>

              <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,0,14,10">
                <CheckBox x:Name="ChkStartFullScreen" Content="启动即进入桌面模式（全屏 + 不进任务栏 + 沉底）"
                          Foreground="#FF44505F" Margin="0,0,20,0"
                          ToolTip="与顶栏的全屏按钮同一语义。窗口永远沉底、不抢焦点（红线 F-4 禁止置顶）。"/>
                <TextBlock x:Name="TxtStartupCommand" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Foreground="#FF8A97A6"
                           ToolTip="调试用的启动命令行（只读）。--Console 会在控制台输出启动与错误信息。"/>
              </StackPanel>

              <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="14,0,14,14">
                <Button x:Name="BtnSavePreferences" Content="保存本机偏好" Width="150"
                        ToolTip="写入 Config/settings.json（原子写）。留空表示沿用 workstation.json 的默认值。"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBox Grid.Row="4" x:Name="TxtSettingOut" Style="{StaticResource Output}"
                   Margin="0,14,0,0"/>
        </Grid>
      </TabItem>

      <!-- ================================================================
           页签 4 · 主数据
           方案 §13.1 锁定决策 21：主数据维护工具形态 = 工作台 GUI 内的「主数据」页签。
           主数据由运维维护并发布到共享；本机只做「拉取快照」与「草稿校验」。
           快照缓存在本机，断网时继续可用。
           ================================================================ -->
      <TabItem Header="主数据">        <Border Style="{StaticResource Region}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,12,14,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="主数据"/>
              <TextBlock Grid.Column="1" Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                         Text="主数据由运维维护并发布到共享；本机只做「拉取快照」与「草稿校验」。快照缓存在本机，断网时继续可用。"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,10">
              <Button x:Name="BtnMdLoad" Content="拉取最新快照"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,0,14,10">
              <TextBlock Text="类型：" VerticalAlignment="Center" Width="52"/>
              <ComboBox x:Name="CmbMdKind" Width="180" Height="26"/>
              <TextBlock Text="文件：" VerticalAlignment="Center" Width="52" Margin="16,0,0,0"/>
              <TextBox x:Name="TxtMdPath" Style="{StaticResource Input}" Width="400"/>
              <Button x:Name="BtnMdValidate" Content="校验草稿" Margin="12,0,0,0"/>
            </StackPanel>

            <TextBox Grid.Row="3" x:Name="TxtMdOut" Style="{StaticResource Output}"
                     Margin="14,0,14,14"/>
          </Grid>
        </Border>
      </TabItem>

    </TabControl>

    <!-- ==================================================================
         Row 2 · 状态条
         摘要只在这里出现一处（顶栏的重复摘要已删除，缺陷 D-8）。
         ================================================================== -->
    <Border Grid.Row="2" Background="#FFE7ECF2" BorderBrush="#FFD5DCE5"
            BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="TxtStatusFull" Text="就绪"
                   Foreground="#FF44505F" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" x:Name="TxtIdentity" Text="设备：未识别"
                   Margin="16,0,16,0" Foreground="#FF44505F" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" x:Name="TxtShare" Text="共享：未检查"
                   Margin="0,0,16,0" Foreground="#FF44505F" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" x:Name="TxtVersion" Text="版本：未知"
                   Foreground="#FF44505F" VerticalAlignment="Center"/>
        <!-- 三态状态灯（绿=正常 / 黄=警告 / 红=报警）：
             这是主窗口内唯一的状态色指示。
             颜色与左侧铭牌【同源同规则】—— 判定在脚本 §8.2 的规则表里做，
             XAML 只提供这个圆点（缺陷 D-10 修好前，这里会在"未接入清单"
             的情形下错误地显示绿色）。 -->
        <Ellipse Grid.Column="4" x:Name="StatusBarDot" Width="10" Height="10"
                 Fill="#FF2FBF71" VerticalAlignment="Center" Margin="14,0,0,0"
                 ToolTip="三态状态灯：绿=正常 / 黄=警告 / 红=报警"/>
      </Grid>
    </Border>
  </Grid>
</Window>
